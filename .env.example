# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any real secret/API key.

# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# EmailJS browser SDK (https://www.emailjs.com/docs/sdk/init/)
# Public Key is safe to expose client-side; it identifies the EmailJS account.
# Service ID and Template ID come from the EmailJS dashboard.
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=